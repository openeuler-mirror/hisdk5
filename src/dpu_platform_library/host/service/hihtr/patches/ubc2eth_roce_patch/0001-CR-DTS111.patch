diff --git a/open_source/hns_roce_v2r12/kernel/CMakeLists.txt b/open_source/hns_roce_v2r12/kernel/CMakeLists.txt
new file mode 100644
index 00000000000..d17acce57c6
--- /dev/null
+++ b/open_source/hns_roce_v2r12/kernel/CMakeLists.txt
@@ -0,0 +1,13 @@
+cmake_minimum_required(VERSION 3.18.1)
+project(hiroce5 C ASM)
+project(hiroce5 VERSION 1.0.0)
+
+
+add_custom_target(hiroce5_ko
+    COMMENT echo "build ${CMAKE_CURRENT_SOURCE_DIR} start for hiroce5.ko ."
+    COMMAND ${MAKE} CONFIG_INFINIBAND_HNS=m -j16 -C ${KDIR} M=${CMAKE_CURRENT_BINARY_DIR} src=${CMAKE_CURRENT_SOURCE_DIR}
+    COMMAND cp -f *.ko ${CMAKE_INSTALL_PREFIX}/ko
+    DEPENDS kernel
+    DEPENDS hisdk5_ko
+    DEPENDS hinic5_ko
+)
\ No newline at end of file
