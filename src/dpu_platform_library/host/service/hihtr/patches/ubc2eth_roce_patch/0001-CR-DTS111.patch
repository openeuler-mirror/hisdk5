diff --git a/src/dpu_platform_library/host/sdk/knldk/lld/hinic5_ubus.c b/src/dpu_platform_library/host/sdk/knldk/lld/hinic5_ubus.c
index 29b3f1293d3..91fcf9a180d 100644
--- a/src/dpu_platform_library/host/sdk/knldk/lld/hinic5_ubus.c
+++ b/src/dpu_platform_library/host/sdk/knldk/lld/hinic5_ubus.c
@@ -256,6 +256,11 @@ static int hinic5_ubus_probe(struct ub_dev *ubus_dev, const struct ub_device_id

 	sdk_info(&ubus_dev->dev, "Ubus device probe begin\n");

+	if (ubus_dev->fe_idx > 3 && ubus_dev->fe_idx < 8) {
+		sdk_info(&ubus_dev->dev, "cyw debug : Not probe fe_idx = %d\n", ubus_dev->fe_idx);
+		return 0;
+	}
+
 	err = hinic5_ubus_init(ubus_dev);
 	if (err != 0)
 		goto out;
